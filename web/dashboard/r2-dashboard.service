[Unit]
Description=Anthill Spec Confidence Dashboard
After=network-online.target

[Service]
User=roycdavies
WorkingDirectory=/mnt/data/Development/R2/anthill/web/dashboard
ExecStart=/usr/bin/python3 server.py --port 8081
